# Copy this file to .env and fill in your SMTP provider settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=tls
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME="Grace Community Church"

# Optional test recipient used by backend/lib/test_email.php
TEST_EMAIL_TO=you@domain.com

# Espees Payment Gateway Configuration
ESPEES_API_KEY=your_espees_api_key_here
ESPEES_SECRET_KEY=your_espees_secret_key_here
ESPEES_MERCHANT_ID=your_merchant_id_here
ESPEES_BASE_URL=https://api.espees.com/v1
ESPEES_CALLBACK_URL=https://yourdomain.com/backend/payments/espees_callback.php
ESPEES_SUCCESS_URL=https://yourdomain.com/profile.html?payment=success
ESPEES_FAIL_URL=https://yourdomain.com/profile.html?payment=failed

# KingsChat OAuth Configuration
KINGSCHAT_CLIENT_ID=your_kingschat_client_id
KINGSCHAT_CLIENT_SECRET=your_kingschat_client_secret
KINGSCHAT_REDIRECT_URI=https://yourdomain.com/backend/kingschat/callback.php
